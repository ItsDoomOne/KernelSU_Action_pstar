# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/Evolution-X-Devices/kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=bka
KERNEL_CONFIG=vendor/lineageos_pstar_suspicion_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld LOCALVERSION=22-suspicion

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_SETUP=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next/kernel/setup.sh
KERNELSU_ROOT=KernelSU-Next
KERNELSU_TAG=legacy
HAS_KSU_SUSFS_PATCHES=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
SUSFS_PATCH=10-ksun-susfs-2.0.0-test.patch
SUSFS_VERSION=2.0.0
Kernel_Version=4.19
Kernel_Extra_Version=4.19.193

